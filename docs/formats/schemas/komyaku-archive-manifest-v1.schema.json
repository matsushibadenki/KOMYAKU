{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komyaku.example/spec/archive/manifest-v1.schema.json",
  "title": "KOMYAKU Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "createdAt", "document", "assets", "extensions"],
  "properties": {
    "format": { "const": "komyaku-archive" },
    "formatVersion": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "path": { "type": "string", "pattern": "^documents/[0-9a-f-]{36}\\.json$" }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mediaType", "byteSize", "sha256", "path"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
          "byteSize": { "type": "integer", "minimum": 1, "maximum": 104857600 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "path": { "type": "string", "pattern": "^assets/sha256/[0-9a-f]{2}/[0-9a-f]{64}$" }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
