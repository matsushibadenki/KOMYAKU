{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acx.dev/schema/experimental/0.1/node-graph-intent.json",
  "title": "Experimental ACX Node Graph Intent 0.1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "document_id",
        "expected_revision",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "edit"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "document_id",
        "expected_revision"
      ],
      "properties": {
        "kind": {
          "const": "run"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "y": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "width": {
          "type": "number",
          "maximum": 1000000000.0,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000000000.0,
          "exclusiveMinimum": 0
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "type": "string",
          "format": "uuid"
        },
        "port": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "from": {
          "type": "object",
          "required": [
            "node",
            "port"
          ],
          "properties": {
            "node": {
              "type": "string",
              "format": "uuid"
            },
            "port": {
              "type": "string"
            }
          }
        },
        "to": {
          "type": "object",
          "required": [
            "node",
            "port"
          ],
          "properties": {
            "node": {
              "type": "string",
              "format": "uuid"
            },
            "port": {
              "type": "string"
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "label",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "id",
            "type_id",
            "rect"
          ],
          "properties": {
            "kind": {
              "const": "create_node"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "type_id": {
              "type": "string",
              "minLength": 1
            },
            "properties": {
              "type": "object"
            },
            "rect": {
              "$ref": "#/$defs/rect"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "delete_node"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id",
            "rect"
          ],
          "properties": {
            "kind": {
              "const": "move_node"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "rect": {
              "$ref": "#/$defs/rect"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "connect"
            },
            "edge": {
              "$ref": "#/$defs/edge"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "disconnect"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "set_property"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "key": {
              "type": "string"
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "group"
          ],
          "properties": {
            "kind": {
              "const": "create_group"
            },
            "group": {
              "$ref": "#/$defs/group"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "delete_group"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "gap"
          ],
          "properties": {
            "kind": {
              "const": "auto_layout"
            },
            "gap": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
