{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOMYAKU Story Graph",
  "version": "0.1.0",
  "identifier": "dev.komyaku.storygraph",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Story Graph \u00b7 KOMYAKU",
        "width": 1040,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 10
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: portrait: http://portrait.localhost https://portrait.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icon.png"
    ]
  }
}
