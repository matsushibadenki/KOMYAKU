{
  "name": "@komyaku/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:agent-editor:package": "tauri build --debug --bundles app --config src-tauri/tauri.agent-editor-qa.conf.json",
    "test:story-agent:package": "tauri build --debug --bundles app --config src-tauri/tauri.story-agent-qa.conf.json",
    "dev": "vite",
    "build": "vite build",
    "check": "vite build",
    "test:e2e": "playwright test",
    "test:preview:package": "tauri build --debug --bundles app --config src-tauri/tauri.preview-qa.conf.json",
    "test:history:package": "tauri build --debug --bundles app --config src-tauri/tauri.history-qa.conf.json",
    "test:editing:package": "tauri build --debug --bundles app --config src-tauri/tauri.editing-qa.conf.json",
    "test:integration:package": "tauri build --debug --bundles app --config src-tauri/tauri.integration-qa.conf.json",
    "test:history-archive:package": "tauri build --debug --bundles app --config src-tauri/tauri.history-archive-qa.conf.json",
