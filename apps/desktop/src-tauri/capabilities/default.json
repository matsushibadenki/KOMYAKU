{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the KOMYAKU main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-execute",
    "allow-save-local-draft-atomic",
    "allow-save-local-version-atomic",
    "allow-list-local-version-history",
    "allow-load-local-version-snapshot",
    "allow-load-local-version-assets",
    "allow-store-local-png-preview-atomic",
    "allow-list-quarantined-local-assets",
    "allow-import-local-komyaku-archive-atomic",
    "allow-list-local-documents",
    "allow-mutate-local-document-atomic",
    "allow-store-cloud-session",
    "allow-load-cloud-session",
    "allow-delete-cloud-session",
    "allow-store-provider-credential",
    "allow-load-provider-credential",
    "allow-delete-provider-credential",
    "allow-save-local-ai-handoff-atomic",
    "allow-load-local-conversation",
    "allow-list-local-conversations",
    "allow-acl-boundary-canary"
  ]
}
