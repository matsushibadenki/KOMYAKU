{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOMYAKU",
  "version": "0.1.0",
  "identifier": "app.komyaku.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KOMYAKU",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' http://127.0.0.1:3000"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:komyaku.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
