NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=komyaku-server
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
DEPLOYMENT_MODE=single
INSTANCE_ID=
SHUTDOWN_GRACE_MS=10000
DATABASE_POOL_MAX=10
JOB_BACKEND=postgres-outbox
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
JOB_BATCH_SIZE=10
JOB_LEASE_SECONDS=60
JOB_POLL_INTERVAL_MS=1000
DATABASE_URL=postgres://komyaku:komyaku@127.0.0.1:5432/komyaku
SESSION_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_SECRET=local-development-only-change-this-secret
IDEMPOTENCY_SECRET=local-development-idempotency-secret-change-this
AUTH_ROUTES_ENABLED=false
PUBLIC_APP_ORIGIN=http://localhost:1420
TRUSTED_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=komyaku-local
OBJECT_STORAGE_ACCESS_KEY=komyaku
OBJECT_STORAGE_SECRET_KEY=change-me-now
AI_TRAINING_DEFAULT=deny
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
